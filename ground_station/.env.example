# ClimCam Ground Station — Environment Configuration
# Copy this file to .env and fill in your values. Never commit .env to git.

# MongoDB connection string (local Docker or Atlas)
MONGODB_URL=mongodb://climcam_user:climcam_pass@mongodb:27017/climcam?authSource=admin

# Database and collection names
DATABASE_NAME=climcam_db
TELEMETRY_COLLECTION=telemetry
ALERTS_COLLECTION=alerts

# API security
API_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
SENSOR_API_KEY=REDACTED_HISTORICAL_TOKEN

# Alert thresholds (override without code change)
ALERT_DESERTIFICATION_WARN_PCT=28.0
ALERT_MOISTURE_CRITICAL_NDWI=-0.10
ALERT_HYDRATION_CRITICAL_PCT=8.0

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=info
