# ClimCam Dashboard — Environment Configuration
# Copy this file to .env.local to configure local dashboard settings.

# FastAPI Ground Station backend URL
VITE_API_BASE=http://127.0.0.1:8000/api

# Optional: Sensor API key for simulated satellite pass ingestion during local development.
# IMPORTANT: In production, leave this empty as sensor keys should never be deployed to public clients.
VITE_SENSOR_KEY=
