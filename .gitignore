# ==============================================================================
# ClimCam ISS Space & Ground Station — Professional .gitignore
# ==============================================================================

# ── Python Virtual Environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Python Bytecode & Cache ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Environment Variables & Credentials ──────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!.env.example
!ground_station/.env.example
!dashboard/.env.example
ground_station/.env
ground_station/.env.*
dashboard/.env
dashboard/.env.local
dashboard/.env.*.local


# ── Node.js / React Frontend (Dashboard) ─────────────────────────────────────
node_modules/
dashboard/node_modules/
dist/
dashboard/dist/
dashboard/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.oxlintcache

# ── OS & IDE Artifacts ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# ── Local Logs & Temporary Files ─────────────────────────────────────────────
*.log
logs/
tmp/
temp/
scratch/
